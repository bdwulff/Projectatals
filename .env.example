# Explicit fake mode for local demonstrations; live mode never falls back to fixtures.
# Node does not auto-load this file; set variables in your host's secret manager.
ATLAS_MODE=fake
ATLAS_DB_PATH=./data/atlas.sqlite
PORT=8787
ATLAS_BIND_HOST=127.0.0.1
ATLAS_CHECK_INTERVAL_MS=300000
# Hosted: use 0.0.0.0, a mounted persistent database path, one replica and HTTPS.
ATLAS_PUBLIC_ORIGIN=
ATLAS_OWNER_ACCESS_KEY=
# Separate >=32-character secret for GET /api/boxsafe/daily-briefing only; optional.
ATLAS_BRIEFING_READ_TOKEN=
ATLAS_ALLOW_INSECURE_LOCAL_FAKE=false

ATLAS_OWNER_NAME=Brandon
ATLAS_OWNER_EMAIL=
ATLAS_OWNER_PHONE=
ATLAS_FROM_ADDRESS=hello@wulffstudio.com.au
ATLAS_ALLOWED_FROM=hello@wulffstudio.com.au
ATLAS_BUDGET_LIMIT_AUD=300
ATLAS_GST_REGISTERED=false

# Require reviewed SELECT-only scope. Never use a service-role key.
BOXSAFE_SUPABASE_URL=
BOXSAFE_SUPABASE_READ_KEY=
BOXSAFE_READ_SCOPE_VERIFIED=false
# Direct REST read-only key; hosted Stripe MCP OAuth is a separate connection.
STRIPE_RESTRICTED_KEY=

# Automatic discovery disabled until a search plan/key and scope are authorised.
BRAVE_SEARCH_API_KEY=
# Free light-use search works without an account. A configured Tavily key uses that account's credits.
ATLAS_RESEARCH_PROVIDER=tavily
TAVILY_API_KEY=
ATLAS_RESEARCH_ENABLED=false
ATLAS_RESEARCH_AREA=Officer, Berwick, Pakenham, Cranbourne, Dandenong, Victoria
ATLAS_RESEARCH_COUNT=3

# Owner-only calls: configure account and originating voice number, then approve costs.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ATLAS_OWNER_CALLS_ENABLED=false
ATLAS_OWNER_CALLS_PER_DAY=1

# Optional generic owner push: provider acceptance is not proof of phone receipt.
ATLAS_OWNER_PUSH_ENABLED=false
NTFY_BASE_URL=https://ntfy.sh
NTFY_ALLOWED_HOST=ntfy.sh
NTFY_OWNER_TOPIC=
NTFY_ACCESS_TOKEN=

# Customer email remains approval-controlled. Do not enable for the hosting trial.
RESEND_API_KEY=
# Select a sender explicitly; saved owner selection in Studio takes precedence.
# Resend supports a verified domain you own, independently of its mailbox host.
ATLAS_OUTREACH_PROVIDER=gmail
# Hosted Gmail uses HTTPS OAuth, not SMTP/app passwords. The private Gmail
# setup panel can instead save an encrypted Google Web client JSON configuration.
# See docs/GMAIL-CONNECTION.md for read-only inbox plus approved sending.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ATLAS_OUTREACH_FROM=
ATLAS_OUTREACH_SENDER_NAME=Brandon Wulff
ATLAS_OUTREACH_CONTACT=
# Optional owner Telegram connection. Credentials can instead be entered in the
# authenticated Devices > Owner updates form (encrypted in the persistent DB).
# Linking never enables deliveries; save owner preferences explicitly in the UI.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
# No general model-driven planner is wired yet; commands use a constrained router.

# Optional ElevenLabs voice. Configure the existing authorised voice and API key
# in Railway's server variables; preview credit use is disabled by default.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ATLAS_ELEVENLABS_ENABLED=false
ATLAS_VOICE_MAX_CHARACTERS_PER_REQUEST=1200
ATLAS_VOICE_MAX_CHARACTERS_PER_DAY=4000
# Optional recorded microphone fallback. Browser speech recognition does not use
# ElevenLabs. Each recorded clip needs an explicit credit-use confirmation.
ATLAS_ELEVENLABS_TRANSCRIPTION_ENABLED=false
ATLAS_TRANSCRIPTION_MAX_REQUESTS_PER_DAY=10
ATLAS_TRANSCRIPTION_MAX_RESERVED_SECONDS_PER_DAY=300
ATLAS_TRANSCRIPTION_MAX_AUDIO_BYTES_PER_DAY=5242880
