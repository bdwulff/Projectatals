# Atlas runtime. Copy to .env (never commit). All optional; absent = fake adapter.
ATLAS_MODE=fake                 # fake | live
ATLAS_DB_PATH=./data/atlas.sqlite
PORT=8787
ATLAS_CHECK_INTERVAL_MS=300000  # scheduled checks cadence (not continuous monitoring)

ATLAS_OWNER_NAME=Brandon
ATLAS_OWNER_EMAIL=
ATLAS_OWNER_PHONE=              # E.164, e.g. +614xxxxxxxx; the only number Atlas may call
ATLAS_FROM_ADDRESS=hello@wulffstudio.com.au   # proposed; domain not yet verified
ATLAS_ALLOWED_FROM=hello@wulffstudio.com.au   # comma-separated verified senders
ATLAS_BUDGET_LIMIT_AUD=300
ATLAS_GST_REGISTERED=false

# BoxSafe (Supabase project wzlntgwsoczgufbavngp). Use a READ-ONLY key or a dedicated
# atlas-read edge function; never the service-role key.
BOXSAFE_SUPABASE_URL=
BOXSAFE_SUPABASE_READ_KEY=

# Stripe restricted key: read-only PaymentIntents + Checkout Sessions.
STRIPE_RESTRICTED_KEY=

# Resend (transactional email for the business mailbox)
RESEND_API_KEY=

# Twilio (outbound owner calls only)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Anthropic (Claude-backed intent parsing and agents; not yet wired)
ANTHROPIC_API_KEY=
